<Project>
  <PropertyGroup>
    <_RepoDepsDir>$(MSBuildThisFileDirectory)../../deps/game</_RepoDepsDir>
    <_MacSteamRoot>$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</_MacSteamRoot>
    <_GameRoot Condition="'$(STS2_STABLE_GAME_DIR)' != ''">$(STS2_STABLE_GAME_DIR)</_GameRoot>
    <_GameRoot Condition="'$(STS2_STABLE_GAME_DIR)' == '' and '$(STS2_GAME_DIR)' != ''">$(STS2_GAME_DIR)</_GameRoot>
    <_GameRoot Condition="'$(_GameRoot)' == ''">$(_MacSteamRoot)</_GameRoot>
    <_MacDataDir>$(_GameRoot)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</_MacDataDir>
    <_MacModsDir>$(_GameRoot)/mods</_MacModsDir>
  </PropertyGroup>

  <Choose>
    <When Condition="Exists('$(_RepoDepsDir)/sts2.dll')">
      <PropertyGroup>
        <Sts2Dll>$(_RepoDepsDir)/sts2.dll</Sts2Dll>
        <BaseLibDll>$(_RepoDepsDir)/BaseLib.dll</BaseLibDll>
        <HarmonyDll>$(_RepoDepsDir)/0Harmony.dll</HarmonyDll>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <Sts2Dll>$(_MacDataDir)/sts2.dll</Sts2Dll>
        <BaseLibDll>$(_MacModsDir)/【001】必装前置/BaseLib（0.2.6）/BaseLib.dll</BaseLibDll>
        <HarmonyDll>$(_MacDataDir)/0Harmony.dll</HarmonyDll>
      </PropertyGroup>
    </Otherwise>
  </Choose>
</Project>
